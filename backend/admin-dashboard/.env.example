# Salin menjadi .env lalu sesuaikan (Windows: copy .env.example .env).
PORT=5000

# Koneksi MySQL (XAMPP / Laragon). `npm run migrate` membuat database bila belum ada, lalu menjalankan
# migration Prisma (prisma/migrations). URL Prisma (DATABASE_URL) disusun otomatis dari DB_* di bawah;
# isi DATABASE_URL hanya bila ingin memakai URL lain, mis. database hosting.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tkbj_admin
DB_USER=root
DB_PASSWORD=

# Ganti dengan string acak yang panjang di lingkungan produksi.
# Masa berlaku token login diatur di halaman Pengaturan → Keamanan → Durasi sesi.
JWT_SECRET=ganti-dengan-rahasia-acak

# Origin frontend yang boleh memanggil API (pisahkan dengan koma), mis. frontend rekan tim.
FRONTEND_URL=http://localhost:3000

# Folder berkas unggahan (galeri & dokumen) dan batas ukuran unggahan galeri.
# Dokumen staf (Modul 03) dibatasi 5 MB di upload.middleware.ts.
UPLOADS_DIR=uploads
UPLOAD_LIMIT_MB=25

# Opsional: token Vercel Blob → foto/video galeri & dokumen staf disimpan di cloud. Kosong = folder uploads/.
BLOB_READ_WRITE_TOKEN=
# Akses lampiran dari aplikasi (bukti bayar, KTP, surat, proposal): private (bawaan) atau public.
# Pakai token yang SAMA dengan backend/mobile-app agar admin bisa membuka lampiran tersebut.
BLOB_ACCESS=private

# Folder lampiran dari aplikasi bila tidak memakai Vercel Blob (= UPLOADS_DIR di backend/mobile-app).
MOBILE_UPLOADS_DIR=../mobile-app/uploads

# "Hari ini" pada data contoh. Agenda terdekat & antrean dihitung dari tanggal ini.
APP_TODAY=2026-10-02
