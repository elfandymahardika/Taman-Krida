# Salin menjadi .env lalu sesuaikan (Windows: copy .env.example .env).
# Port berbeda dari API dashboard (5000) agar keduanya bisa berjalan bersamaan.
PORT=5001

# Database SAMA dengan backend/admin-dashboard: pesanan tiket, bukti transfer, permintaan sewa,
# dan pendaftaran komunitas dari aplikasi langsung masuk ke antrean dashboard admin.
# Jalankan `npm run migrate` + `npm run seed` di backend/admin-dashboard lebih dulu.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tkbj_admin
DB_USER=root
DB_PASSWORD=

# Rahasia token login pengunjung. Boleh berbeda dari JWT_SECRET dashboard.
JWT_SECRET=ganti-dengan-rahasia-acak
# Masa berlaku login di aplikasi (hari).
SESSION_DAYS=30

# Origin yang boleh memanggil API dari browser (Flutter web), pisahkan koma. Kosong = semua origin.
# Aplikasi Android/iOS tidak terkena CORS.
CORS_ORIGINS=

# Folder PRIVAT untuk berkas sewa (KTP, surat, proposal) & bukti transfer bila tidak memakai Vercel Blob.
# Tidak disajikan statis; hanya bisa diunduh pemiliknya (dan admin lewat API dashboard).
UPLOADS_DIR=uploads

# Opsional: token Vercel Blob (sama dengan backend/admin-dashboard) → berkas disimpan di cloud.
BLOB_READ_WRITE_TOKEN=
# private (bawaan, butuh store Blob privat) atau public. Berkas tetap hanya diunduh lewat backend.
BLOB_ACCESS=private

# Alamat publik API dashboard, untuk membentuk URL foto galeri yang diunggah admin (/uploads/...).
ADMIN_PUBLIC_URL=http://localhost:5000

# "Hari ini" pada data contoh, harus sama dengan APP_TODAY di backend/admin-dashboard.
APP_TODAY=2026-10-02
