# Salin menjadi .env lalu sesuaikan (Windows: copy .env.example .env).
# Port berbeda dari API dashboard (5000) agar keduanya bisa berjalan bersamaan.
PORT=5001

# Database SAMA dengan backend/admin-dashboard: pesanan tiket, bukti transfer, permintaan sewa,
# dan pendaftaran komunitas dari aplikasi langsung masuk ke antrean dashboard admin.
# Jalankan `npm run migrate` + `npm run seed` di backend/admin-dashboard lebih dulu.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tkbj_admin
DB_USER=root
DB_PASSWORD=

# Rahasia token login pengunjung. Boleh berbeda dari JWT_SECRET dashboard.
JWT_SECRET=ganti-dengan-rahasia-acak
# Masa berlaku login di aplikasi (hari).
SESSION_DAYS=30

# Origin yang boleh memanggil API dari browser (Flutter web), pisahkan koma. Kosong = semua origin saat
# development, dan tidak ada origin browser bila NODE_ENV=production. Aplikasi Android/iOS tidak terkena CORS.
CORS_ORIGINS=

# Proxy di depan backend (Ngrok). loopback (bawaan) = percayai X-Forwarded-For hanya dari mesin yang sama;
# false = tanpa proxy; angka = jumlah hop proxy di hosting (mis. 1).
TRUST_PROXY=loopback

# Batas umum semua rute /api per IP: RATE_LIMIT_MAX permintaan per RATE_LIMIT_WINDOW_MIN menit (lebih → 429).
# Login & registrasi punya batas sendiri yang lebih ketat.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MIN=15

# Level log (pino): trace, debug, info, warn, error, fatal, silent.
LOG_LEVEL=info

# Folder PRIVAT untuk berkas sewa (KTP, surat, proposal) & bukti transfer bila tidak memakai Vercel Blob.
# Tidak disajikan statis; hanya bisa diunduh pemiliknya (dan admin lewat API dashboard).
UPLOADS_DIR=uploads

# Opsional: token Vercel Blob (sama dengan backend/admin-dashboard) → berkas disimpan di cloud.
BLOB_READ_WRITE_TOKEN=
# private (bawaan, butuh store Blob privat) atau public. Berkas tetap hanya diunduh lewat backend.
BLOB_ACCESS=private

# Alamat publik API dashboard, untuk membentuk URL foto galeri yang diunggah admin (/uploads/...).
ADMIN_PUBLIC_URL=http://localhost:5000

# "Hari ini" mengikuti tanggal sebenarnya (WIB). Isi APP_TODAY=YYYY-MM-DD hanya untuk mengunci tanggal demo.
# APP_TODAY=2026-10-02

# --- Tanya Krida (asisten AI, POST /api/assistant/chat) ---
# Kunci Google Gemini gratis dari https://aistudio.google.com/apikey (awalan "AQ." atau "AIza").
# JANGAN di-commit dan jangan ditaruh di aplikasi Flutter.
# Kosong = Tanya Krida nonaktif (endpoint membalas 503, fitur lain tetap jalan).
GEMINI_API_KEY=
# Model Gemini. Kosong = gemini-3.5-flash-lite (kuota gratis harian terbesar).
AI_MODEL=
# Batas pertanyaan per IP: AI_RATE_LIMIT_MAX per AI_RATE_LIMIT_WINDOW_MIN menit (biaya API dibayar per token).
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MIN=15
