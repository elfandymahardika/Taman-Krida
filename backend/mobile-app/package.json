{
  "name": "tkbj-mobile-api",
  "private": true,
  "version": "0.1.0",
  "description": "REST API untuk aplikasi mobile pengunjung TKBJ (Express + TypeScript + MySQL, Prisma untuk auth), satu database dengan API dashboard admin.",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "npm --prefix ../admin-dashboard run migrate",
    "migrate:fresh": "npm --prefix ../admin-dashboard run migrate:fresh",
    "seed": "ts-node src/db/seeders/run.ts",
    "test": "node --require ts-node/register --require ./test/env.ts --test test/api.test.ts",
    "prisma:sync": "ts-node src/db/syncSchema.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
