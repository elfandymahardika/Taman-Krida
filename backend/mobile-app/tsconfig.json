{
  "compilerOptions": {
    // Panduan memakai es2016; dinaikkan ke es2022 karena kode memakai Array.at, Object.fromEntries, replaceAll.
    "target": "es2022",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src"],
  "ts-node": {
    "transpileOnly": true
  }
}
