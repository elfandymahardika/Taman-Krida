# Salin menjadi deploy/.env di server (JANGAN di-commit; sudah ada di deploy/.gitignore), lalu isi nilainya.
# Semua nilai di sini dibaca saat RUNTIME oleh container; image Docker tidak perlu di-build ulang bila nilai berubah.

# Alamat publik panel admin (tanpa garis miring di akhir). Dipakai CORS API dashboard & URL foto galeri di aplikasi.
PUBLIC_URL=https://tkbj.example.com

# Image dari GitHub Container Registry (diisi otomatis oleh deploy.sh dengan commit SHA saat rilis).
REGISTRY=ghcr.io/elfandymahardika
IMAGE_TAG=latest

# Database MariaDB (container `db`, tidak dibuka ke internet).
DB_NAME=tkbj_admin
DB_USER=tkbj
DB_PASSWORD=ganti-password-database
DB_ROOT_PASSWORD=ganti-password-root

# Rahasia JWT, berbeda untuk tiap API. Buat dengan: openssl rand -base64 48
ADMIN_JWT_SECRET=ganti-rahasia-jwt-dashboard
MOBILE_JWT_SECRET=ganti-rahasia-jwt-mobile

# Opsional
LOG_LEVEL=info
# Origin Flutter web yang boleh memanggil API mobile (pisahkan koma). Kosong = tidak ada (aplikasi Android/iOS tidak butuh CORS).
MOBILE_CORS_ORIGINS=
# Vercel Blob (kosong = berkas disimpan di volume Docker admin-uploads / mobile-uploads).
BLOB_READ_WRITE_TOKEN=
BLOB_ACCESS=private
# Tanya Krida (Google Gemini).
GEMINI_API_KEY=
AI_MODEL=

# Port host Nginx & folder sertifikat TLS (lihat nginx/tls.conf.example).
HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT_DIR=./nginx/certs
