# Versi HTTPS dari default.conf. Cara memakai:
#   1. Dapatkan sertifikat, mis. `certbot certonly --standalone -d tkbj.example.com`
#      (hentikan Nginx sebentar), lalu isi TLS_CERT_DIR=/etc/letsencrypt/live/tkbj.example.com di deploy/.env.
#   2. Ganti server_name di bawah dengan domain Anda.
#   3. cp nginx/tls.conf.example nginx/default.conf && docker compose up -d nginx
# Header Strict-Transport-Security hanya diaktifkan setelah HTTPS dipastikan berjalan.

upstream dashboard {
    server dashboard:3000;
    keepalive 16;
}

upstream mobile_api {
    server mobile-api:5001;
    keepalive 16;
}

# HTTP → HTTPS (kecuali health check internal).
server {
    listen 80;
    listen [::]:80;
    server_name tkbj.example.com;
    server_tokens off;

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name tkbj.example.com;
    server_tokens off;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 30m;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-Id $request_id;

    proxy_next_upstream error timeout http_502 http_503;
    proxy_next_upstream_tries 2;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_min_length 1024;

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location /mobile/ {
        proxy_pass http://mobile_api/;
    }

    location /_next/static/ {
        proxy_pass http://dashboard;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://dashboard;
    }
}
