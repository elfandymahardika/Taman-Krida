# Salin menjadi .env.local (Windows: copy .env.example .env.local), lalu restart `npm run dev`.
# Alamat API backend. Hanya dipakai di SERVER Next.js (proxy /api/be, DAL, Server Action);
# browser selalu memanggil /api/be di domain frontend sendiri, jadi tidak perlu CORS dan token tidak terlihat.
# Backend lokal (bawaan):
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Backend rekan tim lewat Ngrok (tanpa garis miring di akhir, tetap diakhiri /api):
# NEXT_PUBLIC_API_URL=https://xxxxx.ngrok-free.app/api
